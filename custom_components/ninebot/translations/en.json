  "issues": {
    "entity_identity_conflict": {
      "title": "Duplicate legacy entity identities",
      "description": "Multiple legacy entities represent the same function. Their identities and history are preserved; equivalent sensors continue to receive values. No entries were deleted. Review automations and user settings before deciding which entities to retain through the HA UI."
    },
    "migration_identity_invalid": {
      "title": "Legacy account identity is invalid",
      "description": "Migration stopped because the legacy business identity is invalid. Existing configuration and sessions were preserved. Check the backup and confirm the account identity before retrying; do not merge accounts by vehicle nickname."
    },
    "legacy_device_unmatched": {
      "title": "Legacy device identity is unmatched",
      "description": "An existing device identity is absent from the current account vehicle list. The vehicle may have been removed or use a different interface identity. Entities and history are preserved; no nickname-based merge was attempted. Check the backup and current identities before making changes through the HA UI."
    },
    "session_recovery_pending": {
      "title": "Session recovery needs a restart",
      "description": "After a failed session update, HA could not unload the runtime using the replacement session. Its files were not replaced; the transaction journal and previous session backup remain. Back up HA configuration and restart HA to recover the previous session at startup. If recovery fails, retain the backup and check storage permissions; do not manually delete session directories."
    },
    "model_storage_invalid": {
      "title": "Unsupported estimation storage",
      "description": "The estimation storage format or version is unsupported. Setup stopped without overwriting it. Retain a backup and use the integration version matching this storage, or restore a complete pre-upgrade backup. Do not edit the model version field manually."
    },
    "ride_event_storage_invalid": {
      "title": "Ride event storage unavailable",
      "description": "The event cursor store is unreadable, incompatible or cannot be safely written. Event emission is suspended. Retain configuration/storage backups and check storage permissions and the integration version. Do not edit or delete the cursor file as a repair attempt. Other vehicle state and queries remain available."
    }
  },
